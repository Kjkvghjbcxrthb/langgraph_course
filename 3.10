#основная концепция - отдаешь ссылку, получаешь описание видео
from langchain_core.runnables import RunnableLambda

#функция скачивания видео
import urllib.request
def download(url):
    filename = 'C:/Users/Владислав/Desktop/langgraph_course/src/3.9video_homework/example.mp4'
    urllib.request.urlretrieve(url, filename)#скачано
    print('DOWNLOADED')
    return filename

#разделение видео на части по 20 секунд
from moviepy import VideoFileClip
def chunk_it(filename):
    clip = VideoFileClip(filename)
    duration_in_seconds = clip.duration
    path = 'C:/Users/Владислав/Desktop/langgraph_course/src/3.9video_homework/chunks/'
    for i in range(int(duration_in_seconds/20+1)):
        start = i*20
        stop = min(i*20+20,duration_in_seconds)
        #print(start, stop)
        chunk = clip.subclipped(start, stop)
        chunk.write_videofile(path + f'chunk_{i}.mp4', codec="libx264", logger=None)#записан чанк
    clip.close()
    print(f'SPLITTED on {len(os.listdir(path))} files')
    return path

#создание массива путей файлов для batch
import os
def file_paths(path):
    print('PATHS ARRAY PREPARED')
    return ['C:/Users/Владислав/Desktop/langgraph_course/src/3.9video_homework/chunks/' + i for i in os.listdir(path)]

#модель распознавания видео
import base64
from langchain_google_genai import ChatGoogleGenerativeAI
from langchain.messages import HumanMessage, SystemMessage
from settings import settings
api_key = settings.PROXY_API_KEY
llm_video = ChatGoogleGenerativeAI(
    model="gemini-3.1-pro-preview",
    base_url='https://api.proxyapi.ru/google',
    api_key = api_key
)

#описание видео:
os.environ["LANGSMITH_TRACING"] = "false"
os.environ["LANGCHAIN_TRACING_V2"] = "false"
#описание 1 чанка
def describe_chunk(path):
    with open(path, "rb") as f:
        video_data = base64.standard_b64encode(f.read()).decode("utf-8")
    message = HumanMessage(content=[
        {"type": "text", "text": """Decribe shortly in 5-7 sentences what this video is about."""},
        {
            "type": "video",
            "base64": video_data,
            "mime_type": "video/mp4",
        }
        ])
    response = llm_video.invoke([message]).content
    #print(len(response))
    return response[0]['text']

#runnable описание 1 чанка
runnable_describe = RunnableLambda(describe_chunk)

#runnable описание пачки
batched_describe = RunnableLambda(lambda paths: runnable_describe.batch(paths))

#соединение ответов в один и создание краткого описания
from langchain_openai import ChatOpenAI
llm = ChatOpenAI(
    model = 'gpt-5.5',
    api_key = api_key,
    base_url = 'https://api.proxyapi.ru/openai/v1',
    temperature = 0
)
def unite(answers):
    #print(answers)
    #print(len(answers))
    full_text = ' '.join(answers)
    print(f'UNITED {len(answers)} descriptions.')
    messages = [
        SystemMessage(content = [{"type": "text", "text": """You are a professional reteller."""}]),      
        SystemMessage(content = [{"type": "text", "text": """You get a text that prepared with unification of several texts blocks that describe one video. Each of these texts blocks explains stricly one part of video. You should explain what this video about. Chronologically a text you get corresponds to a video."""}]),
        SystemMessage(content = [{"type": "text", "text": """You have to repeat a structure of video."""}]),
        SystemMessage(content = [{"type": "text", "text": """Please, make a text not long. """}]),
        HumanMessage(content = [{"type": "text", "text": f"""Retell, what this text about: {full_text}"""}])
    ]
    response = llm.invoke(messages).content
    print(len(response))
    return response

#LCEL
#на шаге batched_describe происходит распараллеливание цепочки и на шаге unite объединение
runnable =  RunnableLambda(download) | \
            RunnableLambda(chunk_it) | \
            RunnableLambda(file_paths) | \
            batched_describe | \
            RunnableLambda(unite)

#тест
result = runnable.invoke('https://drive.usercontent.google.com/download?id=17RnkfVMXpLMnd9PpGNuQy7_131CWGZ2P&export=download')
print(result)

