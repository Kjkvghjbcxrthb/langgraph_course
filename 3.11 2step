def fetch_url(url:str)->str:
    """Извлечь текстовое содержимое из URL"""
    response = requests.get(url, timeout=10.0)
    soup = BeautifulSoup(response.text, "html.parser")
    result = soup.get_text()
    print(len(result))
    return result
document = fetch_url('https://docs.langchain.com/oss/python/deepagents/rag#rag-chains')


#сплит документа
from langchain_text_splitters import RecursiveCharacterTextSplitter
text_splitter = RecursiveCharacterTextSplitter(
    chunk_size = 1000, chunk_overlap = 0
)
splitted_text = text_splitter.split_text(document)
print(len(splitted_text))


#эмбеддинг модель, на выходе - модель, которая возвращает из массива строк массив векторов
from langchain_openai import OpenAIEmbeddings
from settings import settings, get_balance
embeddings_model = OpenAIEmbeddings(
    base_url = 'https://api.proxyapi.ru/openai/v1',
    api_key = settings.PROXY_API_KEY
)


#создание векторного хранилища
from langchain_core.vectorstores import InMemoryVectorStore
vector_store = InMemoryVectorStore(embedding=embeddings_model)


#добавим документы в хранилище
from langchain_core.documents import Document
documents = [
    Document(
        page_content = doc,
        metadata = {"source": "article"}
    )
    for doc in splitted_text
]
print(len(documents))
vector_store.add_documents(
    documents=documents
)



