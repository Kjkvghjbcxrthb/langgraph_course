import asyncio

from langchain.agents import create_agent
from settings import settings
from langchain.tools import tool
from pydantic import BaseModel
from langchain_openai import ChatOpenAI
api_key = settings.PROXY_API_KEY
from langchain_core.messages import HumanMessage
import requests
from bs4 import BeautifulSoup

#текст по ссылке
@tool
def fetch_url(url:str)->str:
    """This tool returns from article from the link.
    always use ONLY this tools if you are asked to get info grom the link."""
    #парсинг сайта
    response = requests.get(url, timeout=10.0)
    soup = BeautifulSoup(response.text, "html.parser")
    document = soup.get_text()
    #return 'tools are very good'
    return document

#LLM модель
llm = ChatOpenAI(
    model = 'gpt-5.5',
    api_key = api_key,
    base_url = 'https://api.proxyapi.ru/openai/v1'
)

#агент
tools = [fetch_url]
system_prompt="""You are a helpful assistant. Be concise and accurate.
you answer the questions about langchain agent.
use this url https://docs.langchain.com/oss/python/langchain/agents to find information about langchain agent.

"""
agent = create_agent(
    model = llm,
    tools=tools,
    system_prompt=system_prompt
    )


#result = agent.invoke({
#    "messages": [HumanMessage(content="Summarize AI trends")]
#})


async def main():
    get_info_input = HumanMessage('Как правильно настроить tools?')

    async for chunk in agent.astream({"messages": [get_info_input]}, stream_mode="updates"):
        for step, data in chunk.items():
            print(f"\nstep: {step}")
            content = data['messages'][-1].content_blocks
            print(f"content: {(lambda x: 'text' if step == 'tools' else str(content))(step)}")


if __name__ == '__main__':
    asyncio.run(main())

